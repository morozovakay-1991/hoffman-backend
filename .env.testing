APP_NAME=Hoffman
APP_ENV=testing
APP_KEY=base64:jH+hptNDPmhmCdoD8/Bbz7RJdNeVnUK3YPJ5M9FfMmY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (isolated SQLite file — never points at the real dev/prod database).
# File-based rather than :memory: so it survives across separate artisan
# invocations (e.g. migrate:fresh --env=testing followed by db:seed --env=testing);
# a pure :memory: database is destroyed as soon as each CLI process exits.
DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync
CACHE_STORE=array
CACHE_PREFIX=

# Redis (unused while QUEUE_CONNECTION/CACHE_STORE/SESSION_DRIVER stay off redis,
# kept only so config/*.php has something to resolve).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — captured in the array transport, nothing is sent.
MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@hoffman.local
MAIL_FROM_NAME="Hoffman"
MAILHOG_WEB_PORT=8025

# Filesystem — local disk so testing never touches the real MinIO/S3 bucket.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=hoffman
AWS_URL=
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Firebase (push notifications / auth)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# Sentry — disabled for testing
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Social login (mobile apps send a provider token that is verified server-side;
# client_secret/redirect are unused since there is no server-side OAuth redirect flow)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Billing (Stripe — used for all countries except Russia)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_RETURN_URL=

# Billing (CloudPayments — used for Russia)
# CLOUDPAYMENTS_API_SECRET also signs webhook callbacks (Content-HMAC header),
# per CloudPayments' own HMAC scheme.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_BASE_URL=https://api.cloudpayments.ru

VITE_APP_NAME="${APP_NAME}"
